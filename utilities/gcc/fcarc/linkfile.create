MEMORY
{
  samsbanked (rx) : ORIGIN = 0xA000, LENGTH = 0x2000
  ram        (wx) : ORIGIN = 0xC000, LENGTH = 0x4000
}

memcpy = 0x605a;

SECTIONS
{
  OVERLAY : AT (0x10000)
  {
    .bank0 {
      objects/create/_header_create.o(.text)
      objects/create/b0_*.o(.text)
    }
    .bank1 {
      objects/create/b3_create.o(.text)
    }
    .bank2 {
      objects/create/b4_legacy.o(.text)
    }
    .bank3 {
      objects/create/b7_create_file.o(.text)
    }
  } >samsbanked

  . = 0xC000;

  .data : {
    *(.data)
    *(.rodata)
    *(.rodata.*)
  } >ram

  .bss ALIGN(2) : {
    __BSS_START = .;
    *(.bss)
    *(COMMON)
    __BSS_END = .;
  } >ram
}
