MEMORY
{
  samsbanked (rx) : ORIGIN = 0xA000, LENGTH = 0x2000
  ram        (wx) : ORIGIN = 0xC000, LENGTH = 0x4000
}

memcpy = 0x605a;

SECTIONS
{
  OVERLAY : AT (0x10000)
  {
    .bank0 {
      objects/read/_header_read.o(.text)
      objects/read/b0_*.o(.text)
    }
    .bank1 {
      objects/read/b1_read.o(.text)
    }
    .bank2 {
      objects/read/b2_legacy.o(.text)
    }
    .bank3 {
      objects/read/b5_fcarc.o(.text)
    }
    .bank4 {
      objects/read/b6_test.o(.text)
    }
  } >samsbanked

  . = 0xC000;

  .data : {
    *(.data)
    *(.rodata)
    *(.rodata.*)
  } >ram

  .bss ALIGN(2) : {
    __BSS_START = .;
    *(.bss)
    *(COMMON)
    __BSS_END = .;
  } >ram
}
