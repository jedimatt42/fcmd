MEMORY
{
  samsbanked (rx) : ORIGIN = 0xA000, LENGTH = 0x2000 /* 8k code window */
  ram        (wx) : ORIGIN = 0xC000, LENGTH = 0x4000 /* 16k data/bss */
}

/* Force Command provides these routines in every cartridge bank. */
memcpy = 0x605a;

SECTIONS
{
  OVERLAY : AT (0x10000)
  {
    .bank0 {
      objects/_header.o(.text)
      objects/b0_*.o(.text)
    }
    .bank1 {
      objects/b1_*.o(.text)
    }
    .bank2 {
      objects/b2_*.o(.text)
    }
    .bank3 {
      objects/b3_*.o(.text)
    }
    .bank4 {
      objects/b4_*.o(.text)
    }
    .bank5 {
      objects/b5_*.o(.text)
    }
    .bank6 {
      objects/b6_*.o(.text)
    }
    .bank7 {
      objects/b7_*.o(.text)
    }
  } >samsbanked

  . = 0xC000;

  .data : {
    *(.data)
    *(.rodata)
    *(.rodata.*)
  } >ram

  .bss ALIGN(2) : {
    __BSS_START = .;
    *(.bss)
    *(COMMON)
    __BSS_END = .;
  } >ram
}
