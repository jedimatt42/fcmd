; V9938/V9958 detection and pre-initialization for the GPL boot stubs.
; This file is COPYed into gpl-boot.g99 and gpl-powerup.g99.
;
; Two-stage policy:
;   vdp_init_apparent - before the F scan. Only applies the EVPC register
;                       table/palette when the VDP already looks like a 9938.
;   vdp_init_bank     - after the F scan. Runs the VRAM bank test to find a
;                       CaDD hybrid that still looks like a 9918, and applies
;                       the EVPC init only if the test succeeds.

; ---------------------------------------------------------------------------
; Determine the apparent VDP type without unlocking anything and initialize
; only if it already appears to be a 9938/9958.
; ---------------------------------------------------------------------------
vdp_init_apparent:
	; Select status register 4 and read it twice. A 9918/locked F18A
	; returns SR0, whose flags clear after the first read.
	st   >04,@>8C02
	st   >8F,@>8C02
	st   @>8802,@>8375
	st   @>8802,@>8376
	st   >00,@>8C02
	st   >8F,@>8C02

	and  >FE,@>8376
	ceq  >FE,@>8376
	bs   G@vdp_apparent_9938

	; On a 9918/locked F18A the R15 writes above alias into R7. Restore
	; the console's standard white-on-cyan text/backdrop value.
	st   >F7,@>8C02
	st   >87,@>8C02
	rtn

vdp_apparent_9938:
	call G@vdp_evpc_init
	rtn

; ---------------------------------------------------------------------------
; After the F check: test for a hidden 9938-family VDP and initialize it.
; The test uses VRAM >3FFF and restores it, so the first 16K is preserved.
; ---------------------------------------------------------------------------
vdp_init_bank:
	; If it already appeared as a 9938, vdp_init_apparent initialized it.
	st   >04,@>8C02
	st   >8F,@>8C02
	st   @>8802,@>8375
	st   @>8802,@>8376
	st   >00,@>8C02
	st   >8F,@>8C02
	and  >FE,@>8376
	ceq  >FE,@>8376
	bs   G@vdp_bank_done

	; Save the page-0 byte so the test can restore it. >8375 and >8376 are
	; the keyboard/joystick scratch bytes, overwritten by the F-key scan.
	st   >00,@>8C02
	st   >8E,@>8C02
	st   V@>3FFF,@>8375

	; Write a sentinel into page 0, then read the same offset from page 2.
	st   >00,@>8C02
	st   >8E,@>8C02
	st   >AA,V@>3FFF
	st   >02,@>8C02
	st   >8E,@>8C02
	st   V@>3FFF,@>8376
	ceq  >AA,@>8376
	bs   G@vdp_bank_test2
	br   G@vdp_bank_detected

vdp_bank_test2:
	; A second sentinel guards against a coincidental >AA in page 2.
	st   >00,@>8C02
	st   >8E,@>8C02
	st   >55,V@>3FFF
	st   >02,@>8C02
	st   >8E,@>8C02
	st   V@>3FFF,@>8376
	ceq  >55,@>8376
	bs   G@vdp_bank_restore

vdp_bank_detected:
	st   >00,@>8C02
	st   >8E,@>8C02
	st   @>8375,V@>3FFF
	call G@vdp_evpc_init
	rtn

vdp_bank_restore:
	st   >00,@>8C02
	st   >8E,@>8C02
	st   @>8375,V@>3FFF

vdp_bank_done:
	rtn

; ---------------------------------------------------------------------------
; EVPC power-up register table and palette. Leaves R20-R22, R24-R31 and the
; command unit R32-R46 untouched.
; ---------------------------------------------------------------------------
vdp_evpc_init:
	st   >00,@>8C02
	st   >80,@>8C02
	st   >20,@>8C02
	st   >81,@>8C02
	st   >00,@>8C02
	st   >82,@>8C02
	st   >0E,@>8C02
	st   >83,@>8C02
	st   >01,@>8C02
	st   >84,@>8C02
	st   >06,@>8C02
	st   >85,@>8C02
	st   >00,@>8C02
	st   >86,@>8C02
	st   >F7,@>8C02
	st   >87,@>8C02
	st   >08,@>8C02
	st   >88,@>8C02
	st   >02,@>8C02
	st   >89,@>8C02
	st   >00,@>8C02
	st   >8A,@>8C02
	st   >00,@>8C02
	st   >8B,@>8C02
	st   >F7,@>8C02
	st   >8C,@>8C02
	st   >00,@>8C02
	st   >8D,@>8C02
	st   >00,@>8C02
	st   >8E,@>8C02
	st   >00,@>8C02
	st   >8F,@>8C02
	st   >00,@>8C02
	st   >90,@>8C02
	st   >00,@>8C02
	st   >91,@>8C02
	st   >00,@>8C02
	st   >92,@>8C02
	st   >00,@>8C02
	st   >93,@>8C02
	st   >00,@>8C02
	st   >97,@>8C02

	; EVPC default palette, 16 entries through the V9938 palette port.
	st   >00,@>8C02
	st   >90,@>8C02
	st   >00,@>8C04
	st   >00,@>8C04
	st   >00,@>8C04
	st   >00,@>8C04
	st   >00,@>8C04
	st   >06,@>8C04
	st   >33,@>8C04
	st   >07,@>8C04
	st   >07,@>8C04
	st   >00,@>8C04
	st   >27,@>8C04
	st   >03,@>8C04
	st   >50,@>8C04
	st   >00,@>8C04
	st   >07,@>8C04
	st   >06,@>8C04
	st   >70,@>8C04
	st   >00,@>8C04
	st   >73,@>8C04
	st   >03,@>8C04
	st   >60,@>8C04
	st   >06,@>8C04
	st   >64,@>8C04
	st   >06,@>8C04
	st   >30,@>8C04
	st   >04,@>8C04
	st   >65,@>8C04
	st   >03,@>8C04
	st   >55,@>8C04
	st   >05,@>8C04
	st   >77,@>8C04
	st   >07,@>8C04

	; Leave the palette pointer and VRAM page at zero.
	st   >00,@>8C02
	st   >90,@>8C02
	st   >00,@>8C02
	st   >8E,@>8C02
	rtn
